- title ['Local electoral areas', @local_electoral_area.name]

.list-page
  .list-page-header
    %h1= @local_electoral_area.name
    %p.page-subtitle= pluralize @local_electoral_area.active_councillors.count, 'member'
    %hr

  = render partial: @view.to_s, locals: {local_electoral_area: @local_electoral_area}