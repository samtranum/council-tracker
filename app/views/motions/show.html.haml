- title ['Motions', @motion.title]

.motion-show
  .motion-show-intro
    %h1= @motion.title

    - if @motion.body.present? && @motion.body != @motion.title
      .motion-body= @motion.body
    %hr

    - if @motion.result.present?
      .motion-result-row
        .motion-result{class: "-#{@motion.result}"}
          = @motion.result.to_s == 'pass' ? 'Passed' : 'Failed'
        - if @motion.rollcall? && @motion.votes.countable.any?
          - total = @motion.votes.countable.count.to_f
          - pct_for = ((@motion.votes.in_favour.count * 100) / total).round
          - pct_against = ((@motion.votes.in_opposition.count * 100) / total).round
          .motion-bar.-large
            .bar-for{style: "flex-basis: #{pct_for}%"}
            .bar-against{style: "flex-basis: #{pct_against}%"}
            .bar-rest
          .motion-vote-counts
            %span.count-for= "#{@motion.votes.in_favour.count} for"
            %span.count-against= "#{@motion.votes.in_opposition.count} against"
            - if @motion.votes.in_abstention.any?
              %span.count-abstain= "#{@motion.votes.in_abstention.count} abstain"
        .motion-date= @motion.meeting.occurred_on_formatted
    - else
      .motion-date= @motion.meeting.occurred_on_formatted
    %hr

  .motion-show-meta
    .motion-show-left
      - if @motion.attachments.any?
        .motion-section
          %h2 Attachments
          %hr
          - @motion.attachments.each do |attachment|
            = link_to "Attached PDF", @motion.pdf_url, class: 'attachment-link'

      .motion-section
        %h2 Proposers
        %hr
        - if @motion.proposers.any?
          .proposers-list
            - @motion.proposers.each do |councillor|
              = link_to councillor_path(current_council, councillor), class: 'proposer-item' do
                - if councillor.party
                  = render partial: 'icons/party', locals: {party: councillor.party}
                = councillor.full_name
        - else
          %p.empty-value None recorded

    - if @motion.media_mentions.any?
      .motion-show-right
        .motion-section
          %h2 Media Mentions
          %hr
          .media-list
            - @motion.media_mentions.each do |media_mention|
              = render partial: 'media_mentions/media_mention', locals: {media_mention: media_mention}

  .motion-show-votes
    %h2 Votes
    %hr
    = render partial: "voteables/votes", locals: {voteable: @motion}
