- if voteable.rollcall?
  .vote-groups
    - %w(for against abstain).each do |status|
      - votes = voteable.votes.includes(:councillor).by_councillor_name.where(status: status)
      - next if votes.empty?
      .vote-group
        .vote-group-header
          %h3= status.capitalize
          %span.vote-group-count= votes.count
        %hr
        .vote-councillors
          - votes.each do |vote|
            = link_to councillor_path(current_council, vote.councillor), class: 'vote-councillor' do
              - if vote.councillor.party
                = render partial: 'icons/party', locals: {party: vote.councillor.party}
              %span= vote.councillor.full_name

- else
  .voice-vote-notice
    %p
      This motion
      = @motion.result.present? ? "#{@motion.result}ed" : "was decided"
      by a voice vote – we don't have a breakdown of how each councillor voted.
