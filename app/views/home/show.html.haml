- description "Tracking and publishing Fingal County Council's roll-call votes at monthly meetings. See how your councillors voted on issues you care about."
- keywords "fingal county council, vote tracking, open government, councillors"

.slide
  .wrapper{role: 'layout'}
    .text-block.p.-t2
      %h1 Votes at Fingal County Council
      %p.subtitle
        %em Maintained by Dublin Inquirer

      %h3 Recent roll-call votes:

      - if @recent_motions.any?
        %ul.list
          - @recent_motions.each do |motion|
            %li
              = link_to motion.title, motion_path(current_council, motion)
              %br
              %small= motion.meeting.occurred_on.strftime('%B %d, %Y')
        
        .p.-t1
          = link_to "More", motions_path(current_council), class: 'button'
      - else
        %p No recent votes recorded.

      %h3 Select your electoral area to see how your local councillors have been voting:

      - if @local_electoral_areas.any?
        %ul.list.-sentence
          - @local_electoral_areas.each do |area|
            - count = area.active_councillors.count
            %li= link_to raw("#{ render partial: 'icons/count', locals: {count: count} } #{ area.name }"), local_electoral_area_path(current_council.slug, area)
      - else
        %p No electoral areas found.