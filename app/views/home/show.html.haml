- description "Tracking and publishing #{current_council.name}'s roll-call votes at monthly meetings. See how your councillors voted on issues you care about."
- keywords "#{current_council.name.downcase}, vote tracking, open government, councillors"

.home-page
  .home-intro
    %h1= current_council.name
    %hr
    %p
      Click on a motion to see the details of what was proposed, how each councillor voted,
      and links to media coverage of the issue, if we could find any.
    %p
      Click on your local electoral area to see a list of the councillors representing you,
      and then click on their names to see motions they voted on, so you can see how they
      voted on ones you care about.
    %hr

  .home-columns
    .home-motions
      %h2 Motions
      %hr

      - if @recent_motions.any?
        .motions-list
          - @recent_motions.each do |motion|
            = link_to motion_path(current_council, motion), class: 'motion-row' do
              %span.motion-title= motion.title
              .motion-meta
                - if motion.result.present?
                  .motion-result{class: "-#{motion.result}"}
                    = motion.result.to_s == 'pass' ? 'Passed' : 'Failed'
                - if motion.rollcall? && motion.votes.countable.any?
                  - total = motion.votes.countable.count.to_f
                  - pct_for = ((motion.votes.in_favour.count * 100) / total).round
                  - pct_against = ((motion.votes.in_opposition.count * 100) / total).round
                  .motion-bar
                    .bar-for{style: "flex-basis: #{pct_for}%"}
                    .bar-against{style: "flex-basis: #{pct_against}%"}
                    .bar-rest
                %span.motion-date= motion.occurred_on.strftime('%-d %b %Y')

        .home-view-more
          = link_to motions_path(current_council), class: 'view-more-btn' do
            View more →
      - else
        %p No recent votes recorded.

    .home-areas
      %h2 Electoral Areas
      %hr

      - if @local_electoral_areas.any?
        .areas-grid
          - @local_electoral_areas.each do |area|
            = link_to area.name, local_electoral_area_path(current_council.slug, area), class: 'area-tag'
      - else
        %p No electoral areas found.
