- title ['Parties', @party.name]
        .meta-data
          .meta-data_block
            %h1= @party.name
            %p
              #{ pluralize @party.active_councillors.count, 'member' } currently on the council

= svelte_component('Switcher', {basePath: party_path(current_council, @party), renderedView: @view.to_s, currentView: @view.to_s, links: [{view: 'councillors', label: 'Councillors'}]}, class: 'view-subnav')

#switcherView= render partial: @view.to_s, locals: {party: @party}