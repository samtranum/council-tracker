- title ['Parties', @party.name]

.list-page
  .list-page-header
    .party-page-heading
      = render partial: 'icons/party', locals: {party: @party}
      %h1= @party.name
    %p.page-subtitle= pluralize @party.active_councillors.count, 'member'
    %hr

  = render partial: @view.to_s, locals: {party: @party}