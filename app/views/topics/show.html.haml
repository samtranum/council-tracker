- title ['Topics', @tag]
          .meta-data_block
            %h1= @tag
            %p
              #{ pluralize Motion.published.in_category(@tag).count, 'motion' }

= svelte_component('Switcher', {basePath: topic_path(current_council, @tag.parameterize), renderedView: @view.to_s, currentView: @view.to_s, links: [{view: 'motions', label: 'Motions'}]}, class: 'view-subnav')

#switcherView= render partial: @view.to_s, locals: {motions: @motions}

%footer.view-footer
  .wrapper{role: 'layout'}= render partial: 'shared/pagination', locals: {records: @motions}