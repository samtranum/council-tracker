!!!
%html
  %head
    = csrf_meta_tags
    = stylesheet_link_tag 'application', media: 'all'
    = javascript_pack_tag 'application'
    = display_meta_tags site: 'CouncilVoteTracker.ie', reverse: true
    <meta name='viewport' content='width=device-width, initial-scale=1, user-scalable=no' />
    = yield :snippets

  %body
    .standard{role: 'layout'}
      %header.primary-header
        .header-inner
          = link_to root_path, class: 'logo' do
            CouncilVoteTracker.ie
          = link_to "https://dublininquirer.com", target: '_blank', rel: 'noopener', class: 'partner-logo' do
            = image_tag 'https://www.dublininquirer.com/content/images/size/w1600/2026/03/FoxIllustration-running-transparency.png', alt: 'Dublin Inquirer', class: 'fox-logo'
        - if current_council && current_council.header_html.present?
          .council-custom-header= raw current_council.header_html
        - elsif !current_council
          - site_header = SiteSetting.get('site_header')
          - if site_header.present?
            .site-custom-header= raw site_header

      .body-wrap
        %aside.primary-sidebar
          - if current_council
            %nav.primary-nav
              .council-switcher
                = select_tag :council_id,
                  options_for_select(@all_councils.map { |c| [c.name, council_root_path(c.slug)] }, council_root_path(current_council.slug)),
                  onchange: 'window.location=this.value',
                  class: 'council-select'
              = link_to "Motions", motions_path(current_council)
              = link_to "Councillors", councillors_path(current_council)

        %main.primary-main= yield

      %footer.primary-footer
        - if current_council
          - if current_council.footer_html.present?
            .footer-inner.council-custom-footer= raw current_council.footer_html
          .footer-inner.footer-corrections
            Spotted an error?
            = link_to "Submit a correction", new_correction_path(current_council)
            \.
        - else
          - site_footer = SiteSetting.get('site_footer')
          - if site_footer.present?
            .footer-inner= raw site_footer
          - else
            .footer-inner
              This site is maintained by
              = link_to "Dublin Inquirer", "https://dublininquirer.com", target: '_blank', rel: 'noopener'
              \.
              Questions or corrections? Email us at
              = mail_to "sam@dublininquirer.com"
              \.
              To help us maintain this public record, please consider
              = link_to "leaving us a tip", "https://www.dublininquirer.com/tip-jar/", target: '_blank', rel: 'noopener'
              \.
