!!!
%html
  %head
    = csrf_meta_tags
    = stylesheet_link_tag    'admin', media: 'all'
    = javascript_pack_tag 'admin'
    = display_meta_tags site: 'Admin', reverse: true
    <meta name='viewport' content='width=device-width, initial-scale=1, user-scalable=no' />
    = yield :snippets

  %body
    .standard{role: 'layout'}
      %header.primary-header
        .header-inner
          = link_to [:admin, :root], class: 'logo' do
            Admin

      .body-wrap
        - if logged_in?
          %aside.primary-sidebar
            %nav.primary-nav
              = link_to "Meetings", [:admin, :meetings]
              = link_to "Councillors", [:admin, :councillors]
              = link_to "Councils", [:admin, :councils]
              = link_to "Sessions", [:admin, :council_sessions]
              = link_to "Parties", [:admin, :parties]
              = link_to "LEAs", [:admin, :local_electoral_areas]
              - if current_user&.is_admin?
                = link_to "Users", admin_users_path
                = link_to "Site Settings", edit_admin_site_settings_path
              %hr.nav-divider
              = link_to "Corrections", [:admin, :corrections]
              = link_to "Change password", admin_change_password_path
              = link_to "Back to public site", root_path
              = link_to "Log out", logout_path

        %main.primary-main= yield
