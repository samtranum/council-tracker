%header.view-header
  .wrapper{role: 'layout'}
    %h1 Change password

.view-content.-alpha
  .wrapper{role: 'layout'}
    - if flash[:alert]
      .flash.-alert= flash[:alert]

    = form_with url: admin_update_password_path, method: :patch, class: 'admin-form' do |f|
      %div
        = label_tag :current_password, 'Current password'
        = password_field_tag :current_password, nil, autocomplete: 'current-password'

      %div
        = label_tag :new_password, 'New password'
        = password_field_tag :new_password, nil, autocomplete: 'new-password'
        .hint Minimum 8 characters

      %div
        = label_tag :new_password_confirmation, 'Confirm new password'
        = password_field_tag :new_password_confirmation, nil, autocomplete: 'new-password'

      .actions
        = submit_tag 'Update password', class: 'button'
        = link_to 'Cancel', admin_root_path, class: 'button -secondary'
