%header.view-header
  .wrapper{role: 'layout'}
    %h1= link_to "Corrections", [:admin, :corrections]

%main.view-content{role: 'layout'}
  .wrapper{role: 'layout'}
    %table.table
      %thead
        %tr
          %th Date
          %th Subject
          %th Name
          %th
      %tbody
        - @corrections.each do |correction|
          %tr
            %td= correction.created_at.strftime("%d/%m/%Y")
            %td= link_to correction.subject.presence || "(no subject)", [:admin, correction]
            %td= correction.name
            %td.actions
              = link_to "Delete", [:admin, correction], method: :delete, data: { confirm: "Delete this correction?" }, class: "button -small -destructive"

%footer.view-footer
  .wrapper{role: 'layout'}
    = render partial: 'shared/pagination', locals: {records: @corrections}
