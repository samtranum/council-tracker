%header.view-header
  .wrapper{role: 'layout'}
    .breadcrumbs
      .breadcrumb= link_to 'Councils', admin_councils_path
      .breadcrumb= @council.name
    %h1 Edit #{@council.name}

%main.view-content{role: 'layout'}
  .wrapper{role: 'layout'}
    = form_with model: [:admin, @council], local: true, class: 'admin-form', multipart: true do |f|
      = render partial: 'admin/shared/errors', locals: {errors: @council.errors}

      - if current_user.is_admin?
        = f.label :name
        = f.text_field :name

        = f.label :slug
        = f.text_field :slug

        .checkbox-row
          = f.check_box :active
          = f.label :active, 'Active'

        %hr

      %h3 Council logo
      .hint.p.-t5 Shown in the top-right of the header on this council's public pages (replaces the Dublin Inquirer fox logo). Recommended max width: 400px.
      - if @council.logo.present?
        .current-logo
          = image_tag @council.logo.url, style: 'max-height: 60px; margin-bottom: 8px;'
          .checkbox-row
            = f.check_box :remove_logo
            = f.label :remove_logo, 'Remove logo'
      = f.file_field :logo

      %hr

      %h3 Footer content
      .hint.p.-t5 Text shown in the footer before "Spotted an error? Submit a correction."
      = f.text_area :footer_html, rows: 6, class: 'code-input'

      .actions
        = f.submit 'Save', class: 'button'
