%header.view-header
  .wrapper{role: 'layout'}
    .breadcrumbs
      .breadcrumb= link_to 'Councils', admin_councils_path
      .breadcrumb= @council.name
    %h1 Edit #{@council.name}

%main.view-content{role: 'layout'}
  .wrapper{role: 'layout'}
    = form_with model: [:admin, @council], local: true, class: 'admin-form' do |f|
      = render partial: 'admin/shared/errors', locals: {errors: @council.errors}

      - if current_user.is_admin?
        = f.label :name
        = f.text_field :name

        = f.label :slug
        = f.text_field :slug

        .checkbox-row
          = f.check_box :active
          = f.label :active, 'Active'

        %hr

      %h3 Header content
      .hint.p.-t5 HTML shown at the top of this council's public pages. Leave blank for no custom header.
      = f.text_area :header_html, rows: 6, class: 'code-input'

      %h3 Footer content
      .hint.p.-t5 HTML shown in the footer of this council's public pages (above the corrections link).
      = f.text_area :footer_html, rows: 6, class: 'code-input'

      .actions
        = f.submit 'Save', class: 'button'
