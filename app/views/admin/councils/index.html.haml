%header.view-header
  .wrapper{role: 'layout'}
    %h1 Councils

%main.view-content{role: 'layout'}
  .wrapper{role: 'layout'}
    - if current_user.is_admin?
      .list-actions
        = link_to "New Council", new_admin_council_path, class: "button"
    %ul.list.-enumerable
      - @councils.each do |council|
        %li
          .enumerable.-council
            .content
              .title= council.name
              .slug= council.slug
            .detail
              - if council.active?
                %span.tag Active
              - else
                %span.tag Inactive
              - if policy(council).edit?
                = link_to "Edit", edit_admin_council_path(council), class: "button -small"
