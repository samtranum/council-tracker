= form_with model: [:admin, @councillor], local: true do |f|
  - if @councillor.errors.any?
    #error_explanation
      %h2= "#{pluralize(@councillor.errors.count, "error")} prohibited this councillor from being saved:"
      %ul
        - @councillor.errors.full_messages.each do |message|
          %li= message

  .field
    = f.label :council_id
    = f.collection_select :council_id, Council.all, :id, :name, {}, {class: 'form-control'}
  .field
    = f.label :full_name
    = f.text_field :full_name, class: 'form-control'
  .field
    = f.label :party_id
    = f.collection_select :party_id, Party.order(:name), :id, :name, {include_blank: true}, {class: 'form-control'}
    %small= link_to "Add new party", new_admin_party_path, target: "_blank"
  .field
    = f.label :local_electoral_area_id, "Local Electoral Area"
    = f.collection_select :local_electoral_area_id, LocalElectoralArea.order(:name), :id, :name, {include_blank: true}, {class: 'form-control'}
    %small= link_to "Add new area", new_admin_local_electoral_area_path, target: "_blank"
  .field
    = f.label :commenced_on, "Date Elected/Co-opted"
    = f.date_field :commenced_on, value: Date.today, class: 'form-control'
  .field
    = f.label :portrait_file
    = f.text_field :portrait_file, class: 'form-control'

  .actions
    = f.submit 'Save', class: 'button'
