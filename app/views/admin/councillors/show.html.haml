%header.view-header
  .wrapper{role: 'layout'}
    .breadcrumbs
      .breadcrumb= link_to 'Councillors', [:admin, :councillors]
      .breadcrumb= link_to @councillor.full_name, [:admin, @councillor]

.view-content.-alpha
  .wrapper{role: 'layout'}
    .row
      .col-xs-2
        %nav.secondary-nav
          %ul.list.-enumerable
            %li= link_to "Profile", [:admin, @councillor], class: '-active'
            %li= link_to "Terms", [:admin, @councillor, :seats]
            %li= link_to "Media", [:admin, @councillor, :media_mentions]

      .col-xs-10
        .councillor-card
          - portrait_class = @councillor.party.present? ? "-#{ @councillor.party.slug }" : ""
          - if @councillor.portrait.present?
            %figure.-portrait{class: portrait_class}= image_tag @councillor.portrait.url(:medium), loading: 'lazy', alt: "Portrait of #{ @councillor.full_name }"
          .bio
            .meta-data
              .meta-data_block.-label
                %h1= @councillor.full_name
                = link_to "Edit", edit_admin_councillor_path(@councillor), class: "button"
                = link_to "Delete", admin_councillor_path(@councillor), method: :delete, data: { confirm: "Are you sure?" }, class: "button"

              .meta-data_block
                - if @councillor.party.present?
                  %p
                    = render partial: 'icons/party', locals: {party: @councillor.party}
                    = @councillor.party.name
                - if @councillor.local_electoral_area_name.present?
                  %p= @councillor.local_electoral_area_name

              - if @councillor.events.any?
                .meta-data_block
                  %label Electoral history
                  %ol.list
                    - @councillor.events.includes(:eventable).each do |event|
                      %li
                        %span.text.-fixed.-info
                          #{ event.occurred_on.strftime('%b \'%y') } &mdash;
                        %span= raw summarize_event_for_councillor event, @councillor

              - if @councillor.media_mentions.any?
                .meta-data_block
                  %label Media
                  %ul.list.-emmed
                    - @councillor.media_mentions.each do |media_mention|
                      %li= render partial: 'admin/media_mentions/media_mention', locals: {media_mention: media_mention}

        .record-actions
          %label Actions
          .actions
            = link_to "Add a media mention", [:new, :admin, @councillor, :media_mention], class: 'button'