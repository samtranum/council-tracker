.admin-parties
  %h1 Manage Party Colors

  %table.data-table
    %thead
      %tr
        %th Party
        %th Color
        %th Actions
    %tbody
      - @parties.each do |party|
        %tr
          %td
            = render partial: 'icons/party', locals: { party: party }
            = party.name
          %td
            %span.color-preview{style: "background: #{party.color};"}
            %code= party.color
          %td
            = link_to 'Edit', edit_admin_party_path(party), class: 'button -small'

%style
  .color-preview
    display: inline-block
    width: 30px
    height: 30px
    border: 1px solid #ccc
    border-radius: 4px
    vertical-align: middle
    margin-right: 10px
