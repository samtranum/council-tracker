%header.view-header
  .wrapper{role: 'layout'}
    %h1 Parties

%main.view-content{role: 'layout'}
  .wrapper{role: 'layout'}
    - if policy(Party).new?
      .list-actions
        = link_to "New Party", new_admin_party_path, class: "button"
    %ul.list.-enumerable
      - @parties.each do |party|
        %li
          .enumerable.-party
            .content
              .title
                = render partial: 'icons/party', locals: { party: party }
                = party.name
            .detail
              %span.color-swatch{style: "background: #{party.color};"}
              %code= party.color
              = link_to 'Edit', edit_admin_party_path(party), class: 'button -small'
