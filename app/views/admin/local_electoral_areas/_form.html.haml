= form_for [:admin, @local_electoral_area] do |f|
  - if @local_electoral_area.errors.any?
    .errors
      %h3= "#{pluralize(@local_electoral_area.errors.count, 'error')} prohibited this area from being saved:"
      %ul
        - @local_electoral_area.errors.full_messages.each do |message|
          %li= message

  .form-group
    = f.label :name
    = f.text_field :name, class: 'form-control', placeholder: 'e.g. Balbriggan'

  .form-group
    = f.label :council_id
    = f.collection_select :council_id, Council.all, :id, :name, { prompt: 'Select Council' }, { class: 'form-control' }

  .form-group
    = f.label :slug
    = f.text_field :slug, class: 'form-control', placeholder: 'Leave blank to auto-generate from name'
    %p.help-text e.g. 'balbriggan' - used in URLs

  .form-actions
    = f.submit 'Save Local Electoral Area', class: 'button -primary'
    = link_to 'Cancel', admin_local_electoral_areas_path, class: 'button'
