%header.view-header
  .wrapper{role: 'layout'}
    %h1 Local Electoral Areas

%main.view-content{role: 'layout'}
  .wrapper{role: 'layout'}
    .list-actions
      = link_to 'New Local Electoral Area', new_admin_local_electoral_area_path, class: 'button'
    - @councils.each do |council|
      .council-leas
        %h2= council.name
        %ul.list.-enumerable
          - council.local_electoral_areas.by_name.each do |lea|
            %li
              .enumerable.-lea
                .content
                  .title= lea.name
                  .slug= lea.slug
                .detail
                  = link_to 'Edit', edit_admin_local_electoral_area_path(lea), class: 'button -small'
                  = link_to 'Delete', admin_local_electoral_area_path(lea), method: :delete, data: { confirm: 'Are you sure?' }, class: 'button -small -danger'
