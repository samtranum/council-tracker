.councillor-show
  .councillor-show-intro
    - if @councillor.portrait.present?
      .councillor-portrait{class: "-#{@councillor.party&.slug}"}
        = image_tag @councillor.portrait.url(:medium), loading: 'lazy', alt: "Portrait of #{@councillor.full_name}"

    .councillor-intro-text
      %h1= @councillor.full_name
      .councillor-meta
        - if @councillor.party
          = link_to party_path(current_council, @councillor.party), class: 'councillor-party-link' do
            = render partial: 'icons/party', locals: {party: @councillor.party}
            %span= @councillor.party.name
        - if @councillor.local_electoral_area
          %span.councillor-area-link= link_to @councillor.local_electoral_area_name, local_electoral_area_path(current_council.slug, @councillor.local_electoral_area)
    %hr

  - direct_events = @councillor.events.includes(:eventable)
  - uncovered_seats = @councillor.seats_without_events.includes(:council_session, replaced_seat: :councillor)
  - if direct_events.any? || uncovered_seats.any?
    - tagged_events = direct_events.map { |e| [:event, e.occurred_on, e] }
    - tagged_seats = uncovered_seats.map { |s| [:seat, s.commenced_on, s] }
    - history_items = (tagged_events + tagged_seats).sort_by { |_, date, _| date }
    .councillor-show-history
      %h2 Electoral history
      %hr
      %ol.electoral-history-list
        - history_items.each do |type, date, item|
          %li.electoral-history-item
            %span.event-date= date.strftime('%b %Y')
            - if type == :event
              %span.event-description= raw summarize_event_for_councillor(item, @councillor)
            - elsif item.co_option?
              - if item.replaced_seat&.councillor
                %span.event-description= raw "Co-opted to replace #{link_to item.replaced_seat.councillor.full_name, councillor_path(current_council, item.replaced_seat.councillor)}"
              - else
                %span.event-description Co-opted to the council
            - else
              %span.event-description Elected to the council

  .councillor-show-votes
    %h2 Votes
    %hr
    = render partial: @view.to_s, locals: {councillor: @councillor}
