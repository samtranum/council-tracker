- title ['Councillors', @councillor.full_name]
- description "#{ @councillor.full_name } is a #{ @councillor.party.name } councillor representing #{ @councillor.local_electoral_area.name } on Dublin City Council."
- keywords "dublin city council, councillors, #{ @councillor.party.name }, #{ @councillor.local_electoral_area.name }"

%header.view-header
  .wrapper{role: 'layout'}
    .breadcrumbs
      .breadcrumb= link_to 'Councillors', councillors_path(current_council)
      .breadcrumb= link_to @councillor.full_name, councillor_path(current_council, @councillor)

.view-content.-alpha
  .wrapper{role: 'layout'}
    .councillor-card
      - if @councillor.portrait.present?
        %figure.-portrait{class: "-#{ @councillor.party.slug }"}= image_tag @councillor.portrait.url(:medium), loading: 'lazy', alt: "Portrait of #{ @councillor.full_name }"
      .bio
        .meta-data
          .meta-data_block.-label
            %h1= @councillor.full_name

          .meta-data_block
                  %li= render partial: 'media_mentions/media_mention', locals: {media_mention: media_mention}

= svelte_component('Switcher', {basePath: councillor_path(current_council, @councillor), renderedView: @view.to_s, currentView: @view.to_s, links: [{view: 'votes', label: 'Votes'},{view: 'motions', label: 'Proposed motions'},{view: 'amendments', label: 'Proposed amendments'}]}, class: 'view-subnav')

#switcherView= render partial: @view.to_s, locals: {councillor: @councillor}