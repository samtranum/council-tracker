- title 'Councillors'
- if @councillors.any?
  - description "#{pluralize @councillors.count, 'councillor'} currently serve on #{current_council.name}."
- else
  - description "Councillors currently serve on #{current_council.name}."
- keywords "#{current_council.name.downcase}, councillors"

.list-page
  .list-page-header
    %h1 Councillors
    %hr

  .councillors-list
    - @councillors.each do |councillor|
      = link_to councillor_path(current_council, councillor), class: 'councillor-row' do
        .councillor-row-left
          - if councillor.party
            = render partial: 'icons/party', locals: {party: councillor.party}
          %span.councillor-name= councillor.full_name
        .councillor-row-right
          - if councillor.party
            %span.councillor-party= councillor.party.name
          - if councillor.local_electoral_area
            %span.councillor-area= councillor.local_electoral_area.name

  .list-page-pagination
    = render partial: 'shared/pagination', locals: {records: @councillors}
