- title 'Councillors'
- if @councillors.any?
  - description "#{ pluralize @councillors.count, 'councillor' } currently serve on the Dublin City Council."
- else
  - description "Councillors currently serve on the Dublin City Council."
- keywords 'dublin city council, councillors'

%header.view-header
  .wrapper{role: 'layout'}
    %h1= link_to "Councillors", councillors_path(current_council)

%main.view-content{role: 'layout'}
  .wrapper{role: 'layout'}
    %ul.list.-enumerable
      - @councillors.each do |councillor|
        %li
          = link_to councillor_path(current_council, councillor) do
            = render partial: 'councillors/councillor', locals: {councillor: councillor}

%footer.view-footer
  .wrapper{role: 'layout'}
    = render partial: 'shared/pagination', locals: {records: @councillors}